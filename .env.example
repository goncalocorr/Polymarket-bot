# Local environment template.
# Copy to `.env` and fill only the secrets you want to use.

# ========================================
# Mode
# ========================================
# Recommended first run: keep true.
DRY_RUN=true

# ========================================
# Polymarket / Polygon
# ========================================
# Required only for live trading (DRY_RUN=false).
POLYGON_WALLET_PRIVATE_KEY=

# Optional but recommended if you use a Polymarket Safe/proxy wallet.
POLY_SAFE_ADDRESS=0x3a2d961771d9c2fc996e6113861d88b87366062d

# Optional builder credentials for gasless / attributed orders.
POLY_BUILDER_API_KEY=
POLY_BUILDER_API_SECRET=
POLY_BUILDER_API_PASSPHRASE=

# L2 API credentials (auto-derived from private key if empty).
# To derive them once, run: python -m scripts.derive_api_key
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Polygon RPC endpoint.
POLYGON_RPC_URL=https://polygon-rpc.com

# ========================================
# AI
# ========================================
# Required only if you want the AI agent to call Claude.
ANTHROPIC_API_KEY=

# ========================================
# Notifications
# ========================================
# Optional. Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========================================
# External data
# ========================================
# Optional. Leave blank and the AI agent will run without recent news headlines.
NEWSAPI_KEY=

# Optional. Kalshi API v2 requires authentication. Leave blank to skip Kalshi.
# Get credentials at https://kalshi.com/sign-up
KALSHI_API_KEY=
KALSHI_API_SECRET=

# ========================================
# Flash Crash strategy
# ========================================
FLASH_CRASH_SIZE_USDC=5.0
FLASH_CRASH_DROP_THRESHOLD=0.28
FLASH_CRASH_LOOKBACK_SECONDS=12
FLASH_CRASH_TAKE_PROFIT=0.08
FLASH_CRASH_STOP_LOSS=0.04

# ========================================
# Mispricing strategy
# ========================================
MIN_VOLUME_24H_USDC=5000
MAX_SPREAD_CENTS=3
MIN_DAYS_TO_RESOLUTION=3
MAX_DAYS_TO_RESOLUTION=60
MIN_MISPRICING_PCT=0.08
MISPRICING_REENTRY_COOLDOWN_MIN=30

# ========================================
# Risk management
# ========================================
DAILY_LOSS_LIMIT_PCT=0.05
MAX_POSITION_SIZE_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.60
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=3
CIRCUIT_BREAKER_PAUSE_HOURS=2

# ========================================
# Kelly sizing
# ========================================
KELLY_FRACTION=0.50
MIN_KELLY_EDGE=0.03
KELLY_MIN_CONFIDENCE=0.50

# ========================================
# Market quality
# ========================================
MIN_MARKET_QUALITY_SCORE=0.40
MIN_DEPTH_USDC=100.0

# ========================================
# Multi-outcome arbitrage
# ========================================
ARBITRAGE_MAX_SUM=0.97
ARBITRAGE_MIN_OUTCOMES=3
ARBITRAGE_SIZE_USDC=10.0

# ========================================
# Strategy tracker
# ========================================
TRACKER_ROLLING_WINDOW=20
TRACKER_AUTO_PAUSE_WIN_RATE=0.35
TRACKER_AUTO_PAUSE_HOURS=4
TRACKER_BOOST_WIN_RATE=0.65
TRACKER_BOOST_FACTOR=1.50
