# Local environment template.
# Copy to `.env` and fill only the secrets you want to use.

# ========================================
# Mode
# ========================================
# Recommended first run: keep true.
DRY_RUN=true
DRY_RUN_SIMULATED_DELAY_MS=250
DRY_RUN_SLIPPAGE_BPS=35
DRY_RUN_MAKER_MIN_FILL_AGE_S=45
DRY_RUN_MAKER_FORCE_FILL_AGE_S=180
DRY_RUN_MAKER_MIN_COMPETITIVENESS=0.35
DRY_RUN_MAKER_REQUIRE_SCORING=true

# ========================================
# Polymarket / Polygon
# ========================================
# Required only for live trading (DRY_RUN=false).
POLYGON_WALLET_PRIVATE_KEY=

# Optional but recommended if you use a Polymarket Safe/proxy wallet.
POLY_SAFE_ADDRESS=

# Optional builder credentials for gasless / attributed orders.
POLY_BUILDER_API_KEY=
POLY_BUILDER_API_SECRET=
POLY_BUILDER_API_PASSPHRASE=

# L2 API credentials (auto-derived from private key if empty).
# To derive them once, run: python -m scripts.derive_api_key
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Polygon RPC endpoint.
POLYGON_RPC_URL=https://polygon-rpc.com

# ========================================
# AI
# ========================================
# Supported values: auto, openai, anthropic.
AI_PROVIDER=auto

# Required if you want the AI agent to call ChatGPT/OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if you want the AI agent to call Claude/Anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_AI_CALLS_PER_DAY=50

# ========================================
# Notifications
# ========================================
# Optional. Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========================================
# External data
# ========================================
# Optional. Leave blank and the AI agent will run without recent news headlines.
NEWSAPI_KEY=

# Optional. Kalshi API v2 requires authentication. Leave blank to skip Kalshi.
# Get credentials at https://kalshi.com/sign-up
KALSHI_API_KEY=
KALSHI_API_SECRET=
EXTERNAL_PRICE_CACHE_TTL_S=60
KALSHI_MARKETS_CACHE_TTL_S=60

# ========================================
# Flash Crash strategy
# ========================================
FLASH_CRASH_SIZE_USDC=5.0
FLASH_CRASH_DROP_THRESHOLD=0.28
FLASH_CRASH_LOOKBACK_SECONDS=12
FLASH_CRASH_TAKE_PROFIT=0.08
FLASH_CRASH_STOP_LOSS=0.04

# ========================================
# Mispricing strategy
# ========================================
MIN_VOLUME_24H_USDC=5000
MAX_SPREAD_CENTS=3
MIN_DAYS_TO_RESOLUTION=3
MAX_DAYS_TO_RESOLUTION=60
MIN_MISPRICING_PCT=0.08
MISPRICING_REENTRY_COOLDOWN_MIN=30
MISPRICING_MAX_HOLD_MIN=90
MISPRICING_STRIKEOUT_LOSSES=3
MISPRICING_STRIKEOUT_LOOKBACK_HOURS=24
MISPRICING_STRIKEOUT_PAUSE_HOURS=12

# ========================================
# Risk management
# ========================================
TOTAL_CAPITAL=500.0
DAILY_LOSS_LIMIT_PCT=0.05
MAX_POSITION_SIZE_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.60
CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=3
CIRCUIT_BREAKER_PAUSE_HOURS=2

# ========================================
# Kelly sizing
# ========================================
KELLY_FRACTION=0.50
MIN_KELLY_EDGE=0.03
KELLY_MIN_CONFIDENCE=0.50

# ========================================
# Market quality
# ========================================
MIN_MARKET_QUALITY_SCORE=0.40
MIN_DEPTH_USDC=100.0

# ========================================
# Multi-outcome arbitrage
# ========================================
ARBITRAGE_MAX_SUM=0.97
ARBITRAGE_MIN_OUTCOMES=3
ARBITRAGE_SIZE_USDC=10.0

# ========================================
# Reward market maker
# ========================================
# Enabled in DRY_RUN by default in code. For LIVE, also set MAKER_ALLOW_LIVE=true.
MAKER_ENABLED=true
MAKER_ALLOW_LIVE=false
MAKER_LOOP_INTERVAL_S=15
MAKER_MARKETS_CACHE_TTL_S=120
MAKER_CAPITAL_USDC=150
MAKER_MAX_MARKETS=2
MAKER_MAX_PER_MARKET_USDC=60
MAKER_MAX_INVENTORY_USDC=80
MAKER_MIN_QUOTE_SIZE_USDC=10
MAKER_REQUOTE_BPS=25
MAKER_EXIT_PROFIT_BPS=75
MAKER_INVENTORY_SKEW_BPS=35
MAKER_BOOK_STALE_S=20
MAKER_MIN_DAYS_TO_RESOLUTION=2
MAKER_MAX_DAYS_TO_RESOLUTION=45
MAKER_MARKET_MAX_SPREAD_CENTS=4
MAKER_MIN_REWARD_DAILY_RATE=0
MAKER_MIN_REWARD_EFFICIENCY=0.0001
MAKER_RELAX_EFFICIENCY_IN_DRY_RUN=true
MAKER_RELAXED_EFFICIENCY_FACTOR=0.30
MAKER_REQUIRE_MEASURABLE_DAILY_REWARD=true
MAKER_SCORING_REFRESH_S=60

# ========================================
# Strategy tracker
# ========================================
TRACKER_ROLLING_WINDOW=20
TRACKER_AUTO_PAUSE_WIN_RATE=0.35
TRACKER_AUTO_PAUSE_HOURS=4
TRACKER_BOOST_WIN_RATE=0.65
TRACKER_BOOST_FACTOR=1.50

# ========================================
# Scanner
# ========================================
STRATEGY_EVALUATION_TIMEOUT_S=25
